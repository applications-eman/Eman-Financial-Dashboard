{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "CUSTOMER": ["ITEMS"],
    "ITEMS": ["REVIEW"],
    "REVIEW": []
  },
  "screens": [
    {
      "id": "CUSTOMER",
      "title": "Customer",
      "refresh_on_back": true,
      "data": {
        "customers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "alt-text": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "c1",
              "title": "Al Noor Supermarket"
            }
          ]
        },
        "use_ticks": {
          "type": "boolean",
          "__example__": true
        },
        "use_list": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Create invoice"
          },
          {
            "type": "TextSubheading",
            "text": "Step 1 of 3 • Select customer"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "Customer",
            "name": "customer",
            "required": true,
            "visible": "${data.use_ticks}",
            "data-source": "${data.customers}"
          },
          {
            "type": "Dropdown",
            "label": "Customer",
            "name": "customer_pick",
            "required": true,
            "visible": "${data.use_list}",
            "data-source": "${data.customers}"
          },
          {
            "type": "TextCaption",
            "text": "Choose from your assigned customers"
          },
          {
            "type": "Footer",
            "label": "Next",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_customer",
                "customer": "${form.customer}",
                "customer_pick": "${form.customer_pick}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ITEMS",
      "title": "Invoice",
      "refresh_on_back": true,
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "alt-text": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "k1",
              "title": "Shami"
            }
          ]
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "alt-text": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "p1",
              "title": "SHAMI - 5",
              "description": "Maximum 4.50 before VAT"
            }
          ]
        },
        "selected": {
          "type": "string",
          "__example__": "p1"
        },
        "use_ticks": {
          "type": "boolean",
          "__example__": true
        },
        "use_list": {
          "type": "boolean",
          "__example__": false
        },
        "cart_text": {
          "type": "string",
          "__example__": "Your cart is empty."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Step 2 of 3 • Add products"
          },
          {
            "type": "EmbeddedLink",
            "text": "Open cart / edit ›",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "open_cart"
              }
            }
          },
          {
            "type": "TextBody",
            "text": "${data.cart_text}"
          },
          {
            "type": "Dropdown",
            "label": "Category",
            "name": "category",
            "required": true,
            "data-source": "${data.categories}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_category",
                "category": "${form.category}"
              }
            }
          },
          {
            "type": "RadioButtonsGroup",
            "label": "Product",
            "name": "product",
            "required": true,
            "visible": "${data.use_ticks}",
            "data-source": "${data.products}",
            "init-value": "${data.selected}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_product",
                "category": "${form.category}",
                "product": "${form.product}"
              }
            }
          },
          {
            "type": "Dropdown",
            "label": "Product",
            "name": "product_pick",
            "required": true,
            "visible": "${data.use_list}",
            "data-source": "${data.products}"
          },
          {
            "type": "EmbeddedLink",
            "text": "Show all products again",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_category",
                "category": "${form.category}"
              }
            }
          },
          {
            "type": "TextInput",
            "label": "Quantity",
            "name": "qty",
            "input-type": "number",
            "required": true
          },
          {
            "type": "TextInput",
            "label": "Price before VAT",
            "name": "price",
            "input-type": "number",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Add to cart",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "add_item",
                "category": "${form.category}",
                "product": "${form.product}",
                "product_pick": "${form.product_pick}",
                "qty": "${form.qty}",
                "price": "${form.price}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Check invoice",
      "terminal": true,
      "data": {
        "review_text": {
          "type": "string",
          "__example__": "Customer: Al Noor Supermarket\n\n1. SHAMI - 5\n     20 x 4.35 = 87.00"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Step 3 of 3 • Review and send"
          },
          {
            "type": "TextBody",
            "text": "${data.review_text}"
          },
          {
            "type": "EmbeddedLink",
            "text": "Remove last product",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "remove_last"
              }
            }
          },
          {
            "type": "TextCaption",
            "text": "The invoice goes to ZATCA and the PDF arrives in this chat"
          },
          {
            "type": "Footer",
            "label": "Send invoice",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "confirm"
              }
            }
          }
        ]
      }
    }
  ]
}
