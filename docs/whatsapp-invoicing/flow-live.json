{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "CUSTOMER": ["ITEMS"],
    "ITEMS": ["REVIEW"],
    "REVIEW": []
  },
  "screens": [
    {
      "id": "CUSTOMER",
      "title": "Customer",
      "data": {
        "customers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "c1",
              "title": "Al Noor Supermarket"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Choose the customer"
          },
          {
            "type": "Dropdown",
            "label": "Customer",
            "name": "customer",
            "required": true,
            "data-source": "${data.customers}"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_customer",
                "customer": "${form.customer}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ITEMS",
      "title": "Invoice",
      "refresh_on_back": true,
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "k1",
              "title": "Shami"
            }
          ]
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "p1",
              "title": "SHAMI - 5",
              "description": "Maximum 4.50 before VAT"
            }
          ]
        },
        "cart_text": {
          "type": "string",
          "__example__": "Your cart is empty."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "EmbeddedLink",
            "text": "Open cart / edit ›",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "open_cart"
              }
            }
          },
          {
            "type": "TextBody",
            "text": "${data.cart_text}"
          },
          {
            "type": "RadioButtonsGroup",
            "label": "Category",
            "name": "category",
            "required": false,
            "data-source": "${data.categories}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "step": "select_category",
                "category": "${form.category}"
              }
            }
          },
          {
            "type": "Dropdown",
            "label": "Product",
            "name": "product",
            "required": false,
            "data-source": "${data.products}"
          },
          {
            "type": "TextInput",
            "label": "Quantity",
            "name": "qty",
            "input-type": "number",
            "required": false
          },
          {
            "type": "TextInput",
            "label": "Price before VAT",
            "name": "price",
            "input-type": "number",
            "required": false
          },
          {
            "type": "Footer",
            "label": "Add to cart",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "add_item",
                "category": "${form.category}",
                "product": "${form.product}",
                "qty": "${form.qty}",
                "price": "${form.price}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Cart",
      "terminal": true,
      "data": {
        "review_text": {
          "type": "string",
          "__example__": "Customer: Al Noor Supermarket\n\n1. SHAMI - 5: 20 x 4.35 = 87.00"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "0",
              "title": "1. SHAMI - 5: 20 x 4.35"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "${data.review_text}"
          },
          {
            "type": "TextBody",
            "text": "To change or remove a product, choose it below. To add more products, tap the back arrow."
          },
          {
            "type": "Dropdown",
            "label": "Product in the cart",
            "name": "line",
            "required": false,
            "data-source": "${data.lines}"
          },
          {
            "type": "TextInput",
            "label": "New quantity (optional)",
            "name": "qty",
            "input-type": "number",
            "required": false
          },
          {
            "type": "TextInput",
            "label": "New price (optional)",
            "name": "price",
            "input-type": "number",
            "required": false
          },
          {
            "type": "EmbeddedLink",
            "text": "Change this product",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "update_line",
                "line": "${form.line}",
                "qty": "${form.qty}",
                "price": "${form.price}"
              }
            }
          },
          {
            "type": "EmbeddedLink",
            "text": "Remove this product",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "remove_line",
                "line": "${form.line}"
              }
            }
          },
          {
            "type": "Footer",
            "label": "Create invoice",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "confirm"
              }
            }
          }
        ]
      }
    }
  ]
}
