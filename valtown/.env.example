# Set these in Val Town > Environment variables (never commit real values).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=          # Supabase > Settings > API > JWT secret (HS256). Leave empty if the project uses asymmetric keys (JWKS is used).
WA_TOKEN=                     # permanent system-user token
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_APP_SECRET=                # Meta app secret: signs webhook + Flow requests, and flow tokens
WA_VERIFY_TOKEN=              # any random string, entered in the Meta webhook setup
WA_FLOW_PRIVATE_KEY=          # PEM (newlines may be written as \n)
WA_FLOW_PRIVATE_KEY_PASSPHRASE=
ALLOWED_ORIGIN=               # the Cloud Run URL of the dashboard, e.g. https://eman-expenses-xxxx.a.run.app
# optional
WA_GRAPH_VERSION=v23.0
